# ExtraCare Web: caching and compression for Hostinger (Apache / LiteSpeed)

# Pages: always check for a newer version, so updates show at once
<IfModule mod_headers.c>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Styles, scripts and images are linked with ?v= numbers, so they can be kept for a year
  <FilesMatch "\.(css|js|svg|jpg|jpeg|png|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/xml text/plain
</IfModule>

AddType image/webp .webp
AddType image/svg+xml .svg

ErrorDocument 404 /404.html
